{
  "name": "bird-family-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/backend.test.mjs && node --experimental-strip-types tests/recipe-ocr.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --import ./scripts/local-tool-env.mjs node_modules/vinext/dist/cli.js dev",
    "db:generate": "drizzle-kit generate",
    "start": "node --import ./scripts/local-tool-env.mjs node_modules/wrangler/bin/wrangler.js dev --local --config dist/server/wrangler.json --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "6.0.1",
    "@tesseract.js-data/eng": "1.0.0",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "4.20260515.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
