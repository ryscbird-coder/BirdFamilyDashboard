{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vinext/types"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "server/**/*.ts",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "db/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts"
  ]
}
